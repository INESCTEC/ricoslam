<launch>

  <arg name="dataset"  default="cappero"/>
  <arg name="rate"     default="1.0"/>
  <arg name="rviz"     default="false"/>
  <arg name="start"    default="0.0"/>

  <param name="/use_sim_time" value="true"/>

  <include file="$(dirname)/play_$(arg dataset).xml">
    <arg name="rate"  default="$(arg rate)"/>
    <arg name="rviz"  value="$(arg rviz)"/>
    <arg name="start" default="$(arg start)"/>
  </include>

</launch>
