<launch>

  <arg name="dataset"  default="intel"/>
  <arg name="frame_id" default="odom"/>
  <arg name="rate"     default="1.0"/>
  <arg name="rviz"     default="false"/>
  <arg name="start"    default="0.0"/>

  <param name="/use_sim_time" value="true"/>

  <include file="$(dirname)/play_rviz.xml">
    <arg name="frame_id" value="$(arg frame_id)"/>
    <arg name="rviz"     value="$(arg rviz)"/>
  </include>

  <node pkg="rosbag" type="play" name="play" output="screen"
      args="--clock --delay 1.0 --keep-alive --start $(arg start) --rate $(arg rate) $(dirname)/../bag/$(arg dataset).clf.sort.bag"/>

</launch>
